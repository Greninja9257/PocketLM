# vscode AI rules
.github/instructions/codacy.instructions.md

__pycache__/
*.pyc
.venv/

# Training checkpoints and logs. The portable .npz exports are committed
# instead — they carry weights, tokenizer and config in one file and run
# without torch.
checkpoints/*.pt
checkpoints/*.log
checkpoints/*.npz
checkpoints/memory.json
eval/results/

# The bootstrap corpus is generated deterministically from a seed:
#   make data      (scripts/build_corpus.py --seed 7)
# 21 MB of slot-filled templates is not worth versioning; the generator is.
data/

# Per-branch working directories. Each experimental branch keeps its generated
# corpora and models under its own directory, and none of it is committed —
# these are ignored on every branch so that checking one out never drags
# another's artefacts into the tree.
testing/data/
testing/checkpoints/
testing/*.log
testing/__pycache__/
dev/data/
dev/checkpoints/
dev/*.log
dev/__pycache__/

# models/ is the published home for every trained model — deliberately
# tracked, unlike the per-branch working directories above.
!models/
